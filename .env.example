# Telegram (получить у @BotFather)
TG_BOT_TOKEN=

# Ollama
OLLAMA_URL=http://localhost:11434
# Production: qwen3-vl для classify/VLM-fallback. OCR/TEXT можно развести:
VLM_MODEL=qwen3-vl:8b-instruct
# TEXT_MODEL=qwen3-vl:8b-instruct   # structure text-layer / OCR-текст (можно qwen3:8b)
# OCR_MODEL=qwen3-vl:8b-instruct    # free-text OCR; НЕ glm-ocr по умолчанию (ломает 011/СИБР)
# IMAGE_EXTRACT_LONG_SIDE=1600      # e2e 2026-08-03: 1600 = 34/34, быстрее 2200; 1280 не гоняли

# Любой скалярный параметр config.json переопределяется одноимённой env-переменной
# в ВЕРХНЕМ_РЕГИСТРЕ (12-factor; порядок: env → config.json → встроенный дефолт).
# Примеры VLM:
# VLM_TEMPERATURE=0.0
# VLM_NUM_CTX=8192
# VLM_NUM_PREDICT=2048
# Reasoning-бенч: финальный answer отделён от thinking; пустой answer повторяется с think=false.
# REASONING_NUM_PREDICT=8192
# REASONING_THINK=medium
# Для OCR/извлечения, где reasoning не нужен: VLM_DISABLE_THINKING=1
# VLM_MAX_TOKENS=4096
# Примеры прочих (раньше env не читали):
# PDF_RENDER_DPI=200
# IMAGE_JPEG_QUALITY=90
# DRUG_RATIO_FLOOR=70
# ANALYTE_RATIO_FLOOR=75
# OLLAMA_PROBE_TIMEOUT=1.5          # таймаут пинга Ollama (с)
# OLLAMA_WSL_DETECT_TIMEOUT=5.0     # таймаут wsl hostname -I (с)
# RAW_LOG_LIMIT=4000               # потолок длины сырого ответа модели в DEBUG-логе

# SQLite
SQLITE_PATH=./data/botkin.db

# Директория для загруженных файлов
SOURCES_DIR=./sources

# URL бэкенда (для бота)
API_URL=http://localhost:8000
# RAG (эмбеддинги и рекомендации через Ollama)
# RAG_EMBED_MODEL=bge-m3
# RAG_RECOMMEND_MODEL=qwen3:8b
# Мощная uncensored-модель для комплексных lifestyle-рекомендаций (/api/rag/lifestyle)
# RAG_LIFESTYLE_MODEL=huihui_ai/Qwen3.6-abliterated:27b
# RAG_TOP_K=8

# Health-sync
# HEALTH_TOKENS_DIR=./data/health_tokens   # OAuth-токены провайдеров (вне git)
# HEALTH_SYNC_DAYS=30
# HEALTH_REQUEST_PAUSE=0.5                 # пауза между запросами к Garmin (rate limit)

# Strava OAuth (регистрация приложения: strava.com/settings/api)
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=

# Роли: telegram-id администраторов через запятую (роль admin присваивается при входе)
# ADMIN_TELEGRAM_IDS=113521070

# Веб-кабинет: дебаг-вход без cookie сессии и без заголовка X-Telegram-User-Id.
# Если задан (> 0) — API работает от имени этого telegram_user_id.
# ТОЛЬКО для локального запуска/дебага; в проде не задавать.
# WEB_DEBUG_USER_ID=0

# Хранилище оригиналов: local (диск, по умолчанию) или minio.
# MinIO локально: docker compose -f docker-compose.minio.yml up -d
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=localhost:9000
# MINIO_BUCKET=botkin-documents
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_SECURE=0
