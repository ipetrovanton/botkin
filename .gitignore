sources/

# Вход build-скрипта справочника (большая выгрузка ГРЛС) — не коммитим, см. registry.jsonl
grls*.zip

# Pytest artifacts
pytest-cache-files-*/

# OS
.DS_Store
Thumbs.db

# Секреты и локальные тестовые образцы — НЕ коммитить
token.txt
example.jpg.jpg
*.jpg.jpg
sample_*.pdf
sample_*.jpg
sample_*.jpeg
sample_*.png
sample_*.heic
sample_*.heif
sample_*.webp

# Реальные документы для e2e (могут содержать ПДн) — сами файлы НЕ коммитим,
# но версионируем разметку *.expected.json и README для воспроизводимости тестов.
tests/fixtures/documents/*
!tests/fixtures/documents/README.md
!tests/fixtures/documents/*.expected.json
!tests/fixtures/documents/samples/
tests/fixtures/documents/samples/*
!tests/fixtures/documents/samples/*.expected.json

# Служебные отладочные скрипты и логи (только в корне: паттерн без якоря
# матчил бы и src/**/__init__.py)
/_*.py
/_*.log
/_*.out
/_*.json
/_*.txt
/_*.jpg
/_*.png

# Health-sync: OAuth-токены провайдеров — секреты, не коммитим
data/health_tokens/

# Patient data — база и манифест исследований, не коммитим
data/

# Внутренние директории инструментов
.agents/
.remember/
skills-lock.json

# Временные тестовые дампы
tests/_dump_*
tests/_last_run.txt

# Сгенерированные PDF-артефакты
habr/*.pdf

# Bench-артефакты прогонов: логи и текстовые дампы. Сами скрипты scripts/bench/*.py
# и данные сравнения bench_models_results.json — версионируем.
bench_*.log
e2e_run.log
scripts/bench/*.log
scripts/bench/*.txt
extract_text.py
test_baseline.jpg
test_image.jpg
test_image.png

# Источники справочников (большие выгрузки ФСЛИ) — в репо только собранный registry.jsonl
справочник_лабораторных_тестов.json
Справочник лабораторных тестов.xlsx